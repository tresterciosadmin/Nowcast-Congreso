!variables/proyecto/data/curva_ciclo_presidencial.csv
# Estimaciones de gamma del ICG: el equipo tiene que poder verlas sin correr nada.
!variables/proyecto/outputs/*.json
# Muestra manual de taxonomias: 88 actas clasificadas A MANO por Valle. Es el set
